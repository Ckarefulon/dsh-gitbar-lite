# Normalize every text file to LF in the repository. The client bundle in
# lib/client.js is hand-written and ships without a build step, so the committed
# bytes are exactly the bytes the module loader evaluates; keeping them LF
# avoids a whole-file diff on every checkout and keeps the bundle byte-stable
# across platforms.
* text=auto eol=lf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# GitHub language stats: the shipped code is JavaScript.
*.js linguist-language=JavaScript
